{
  // Configuration Cloudflare Worker — Urgence'Rachis (statique + API IA)
  // Déploiement : « npx wrangler deploy »
  //
  // Secrets requis (Workers > urgences-rachis-paris > Settings > Variables and Secrets) :
  //   - ANTHROPIC_API_KEY (obligatoire, type Secret)
  //   - STATS_KEY (optionnel : clé d'accès à /api/stats)
  "name": "urgences-rachis-paris",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "URGENCE_KV", "id": "8578258e537e45998f97f0ef80685f6f" }
  ]
}
